rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function rank(role) {
      return role == 'Leader'    ? 4 :
             role == 'Co-Leader' ? 3 :
             role == 'Officer'   ? 2 :
             role == 'Member'    ? 1 :
             role == 'Recruit'   ? 0 : -1;
    }
    function treasuryNotLower(k) {
      return request.resource.data.treasury.get(k, 0) >= resource.data.treasury.get(k, 0);
    }
    // true while NO leadership election is open in that kingdom (ranks and kicks are frozen during one)
    function noElection(kid) {
      return get(/databases/$(database)/documents/rc_kingdoms/$(kid)).data.get('election', null) == null;
    }
    function myDoc() {
      return get(/databases/$(database)/documents/rc_players/$(request.auth.uid)).data;
    }

    match /rc_players/{playerId} {
      allow read: if request.auth != null;

      // A new character must start like a new character (no free level/gold/XP).
      allow create: if request.auth != null && request.auth.uid == playerId &&
        request.resource.data.level == 1 &&
        request.resource.data.xp == 0 &&
        request.resource.data.gold <= 150;

      allow delete: if false;

      // NOTE: request.auth.uid == playerId still grants a player FULL write access to
      // their OWN doc below. That is intentional for now — Crafting, Market (buyer
      // side), Road, Skills, Equipment and PvP still write energyCur/xp/gold/inventory
      // directly from the client because they haven't been moved to Cloud Functions
      // yet. This means a player can still edit their own resources from devtools;
      // it is NOT fixed by this ruleset. Only PvE/Elite/Boss are server-authoritative
      // so far (see functions/index.js). Everything below this line only restricts
      // writes where someone OTHER than the doc's own player is the actor.
      allow update: if request.auth != null && (
        request.auth.uid == playerId ||

        // Market seller credit: the requester must be someone else, must reference a
        // still-existing listing (checked BEFORE it's deleted — see the reordered
        // buyListing() in storage.js) where this player is the seller, and the
        // credited amount must exactly equal that listing's price. Nothing else moves.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gold', 'lastCreditedListingId']) &&
          request.auth.uid != playerId &&
          request.resource.data.lastCreditedListingId is string &&
          exists(/databases/$(database)/documents/rc_marketListings/$(request.resource.data.lastCreditedListingId)) &&
          get(/databases/$(database)/documents/rc_marketListings/$(request.resource.data.lastCreditedListingId)).data.sellerId == playerId &&
          request.resource.data.gold == resource.data.gold +
            get(/databases/$(database)/documents/rc_marketListings/$(request.resource.data.lastCreditedListingId)).data.totalPrice
        ) ||

        // Kick: actor is Officer+ in the SAME kingdom as the target, and outranks
        // them. Only these three fields move, to the "kicked" shape.
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['kingdomId', 'kingdomRole', 'kingdomCooldownUntil']) &&
          request.resource.data.kingdomId == null &&
          request.resource.data.kingdomRole == null &&
          request.resource.data.kingdomCooldownUntil > resource.data.kingdomCooldownUntil &&
          myDoc().kingdomId == resource.data.kingdomId &&
          rank(myDoc().kingdomRole) >= 2 &&
          rank(myDoc().kingdomRole) > rank(resource.data.kingdomRole) &&
          noElection(resource.data.kingdomId)
        ) ||

        // Promote / demote: actor is Co-Leader+ in the SAME kingdom, outranks the
        // target, and can't hand out a rank at or above their own. Only kingdomRole
        // moves, and only to one of the five known roles.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kingdomRole']) &&
          myDoc().kingdomId == resource.data.kingdomId &&
          rank(myDoc().kingdomRole) >= 3 &&
          rank(myDoc().kingdomRole) > rank(resource.data.kingdomRole) &&
          rank(request.resource.data.kingdomRole) >= 0 &&
          rank(request.resource.data.kingdomRole) < rank(myDoc().kingdomRole) &&
          noElection(resource.data.kingdomId)
        ) ||

        // Elections / succession (SPARK MODE: the browser runs functions/lib/governance.js, so a citizen's client must be
        // able to change OTHER citizens' rank when an election is counted or an absent Leader is replaced). Narrow on purpose:
        //  - only kingdomRole moves, between two citizens of the same kingdom;
        //  - a player becomes 'Leader' only if the kingdom doc, in the SAME commit, names that player as leaderId;
        //  - everything else can only go DOWN (the dismissed old government / the old Leader).
        // With Blaze (Admin SDK in Cloud Functions) delete this clause: the functions bypass the rules.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kingdomRole']) &&
          myDoc().kingdomId == resource.data.kingdomId &&
          rank(request.resource.data.kingdomRole) >= 0 &&
          (
            (request.resource.data.kingdomRole == 'Leader' &&
              getAfter(/databases/$(database)/documents/rc_kingdoms/$(resource.data.kingdomId)).data.leaderId == playerId) ||
            (request.resource.data.kingdomRole != 'Leader' &&
              rank(request.resource.data.kingdomRole) < rank(resource.data.kingdomRole))
          )
        )
      );
    }

    // Market sale notices (checkMarketSales() / buyListing() in storage.js):
    // a create-only doc the BUYER drops into the SELLER's own subcollection
    // to tell them what sold. Only the owning player can ever read or clear
    // it; a buyer can create one but never touch it again afterwards.
    match /rc_players/{playerId}/marketSales/{saleId} {
      allow read, delete: if request.auth != null && request.auth.uid == playerId;

      allow create: if request.auth != null && request.auth.uid != playerId &&
        request.resource.data.keys().hasOnly(['buyerName', 'itemLabel', 'totalPrice', 'ts']) &&
        request.resource.data.totalPrice is number && request.resource.data.totalPrice > 0;

      allow update: if false;
    }

    // PvP result notices (checkPvpResults() / endCombat() in the client): a create-only doc the player who FOUGHT
    // drops into the OPPONENT's own subcollection. The owner applies it to their own character and clears it.
    // The rating step is capped at +/-32 (ELO_K) so a forged notice can't swing the ladder.
    match /rc_players/{playerId}/pvpResults/{resultId} {
      allow read, delete: if request.auth != null && request.auth.uid == playerId;

      allow create: if request.auth != null && request.auth.uid != playerId &&
        request.resource.data.keys().hasOnly(['ts', 'fromName', 'result', 'delta']) &&
        request.resource.data.result in ['win', 'lose', 'draw'] &&
        request.resource.data.fromName is string && request.resource.data.fromName.size() <= 40 &&
        request.resource.data.delta is number && request.resource.data.delta >= -32 && request.resource.data.delta <= 32;

      allow update: if false;
    }

    match /rc_kingdoms/{kingdomId} {
      allow read: if request.auth != null;

      // A brand-new kingdom doc is only ever created by whoever becomes its first
      // Leader, starting empty.
      allow create: if request.auth != null &&
        request.resource.data.leaderId == request.auth.uid &&
        request.resource.data.treasury == {} &&
        request.resource.data.chat == [];

      allow update: if request.auth != null && (
        // Leadership (SPARK MODE: the browser runs functions/lib/governance.js + community.js): terms, elections, candidate
        // lists, votes, an empty seat being claimed, a Leader handing over. Only these fields move, and only for a citizen of
        // THIS kingdom. A client can no longer simply write itself into an empty seat from the UI: claiming goes through the
        // claimLeadership function, which refuses it wherever a real vote is possible.
        // With Blaze (Admin SDK in Cloud Functions) delete this clause: the functions bypass the rules.
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['leaderId', 'termEndsAt', 'election', 'lastElection', 'absenceElectionBlockedUntil', 'chat']) &&
          myDoc().kingdomId == kingdomId
        ) ||

        // Leader stepping down: only the current Leader can clear their own seat.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leaderId']) &&
          resource.data.leaderId == request.auth.uid &&
          request.resource.data.leaderId == null
        ) ||

        // Donate: only the treasury map changes, exactly one resource key moves, nothing is
        // removed, and no known resource may go DOWN (so a donation can only add).
        // NOTE: a Set has no toList() in the rules language, so we cannot pull "the changed key"
        // out of affectedKeys(); instead every known resource is checked with treasuryNotLower().
        // Requires storage.js to write with dot-notation (treasury.<resource>).
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['treasury']) &&
          request.resource.data.treasury.diff(resource.data.treasury).affectedKeys().size() == 1 &&
          request.resource.data.treasury.diff(resource.data.treasury).removedKeys().size() == 0 &&
          treasuryNotLower('gold') && treasuryNotLower('wood') && treasuryNotLower('stone') &&
          treasuryNotLower('iron') && treasuryNotLower('food') && treasuryNotLower('herbs') &&
          myDoc().kingdomId == kingdomId
        ) ||

        // Kingdom chat: membership required, nothing else moves.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chat']) &&
          request.resource.data.chat.size() <= 80 &&
          myDoc().kingdomId == kingdomId
        )
      );

      allow delete: if false;
    }

    match /rc_marketListings/{listingId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null && request.resource.data.sellerId == request.auth.uid &&
        request.resource.data.totalPrice is number && request.resource.data.totalPrice > 0;

      // Update is ONLY the short-lived buy-lock (acquireDocLock in storage.js) —
      // nothing about price, quantity, seller or item can change after creation.
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['__lockHolder', '__lockUntil']);

      // The seller can always cancel their own listing. A non-seller deleting it is
      // assumed to be completing a purchase — the actual payment correctness for
      // that is enforced independently by the seller's player-doc update rule above
      // (which requires this exact listing to still exist and match on price/seller
      // at the moment it runs), not by this rule. Worst case if someone deletes a
      // listing without buying it: the seller loses the listing but not any gold —
      // a nuisance, not a currency exploit.
      allow delete: if request.auth != null;
    }

    // Combat session (PvE fight in progress) — only its owner.
    match /rc_players/{playerId}/combat/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == playerId;
    }

    // ---- Country economy & wars (SPARK MODE) -------------------------------------
    // While Cloud Functions are off, the browser runs the war/economy logic itself
    // (js/server-local.js), so signed-in players must be able to write these.
    // When Blaze is on, switch these back to `allow write: if false;` (see the
    // original rules) and deploy the functions again.
    match /rc_countries/{countryId} {
      allow read, write: if request.auth != null;
    }
    match /rc_wars/{warId} {
      allow read, write: if request.auth != null;
      match /rounds/{roundId} {
        allow read, write: if request.auth != null;
      }
    }
    match /rc_warPlayers/{docId} {
      allow read, write: if request.auth != null && docId.matches('.*_' + request.auth.uid);
    }
    // Monthly resource distribution (SPARK MODE: the browser runs the server logic). With Blaze, make these `allow write: if false;`.
    match /rc_world/{docId} {
      allow read, write: if request.auth != null;
    }
    match /rc_resource_cycles/{monthKey} {
      allow read, write: if request.auth != null;
    }
    match /rc_resource_cycles_archive/{docId} {
      allow read, write: if request.auth != null;
    }
    match /rc_config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ---- Shop: gems + cosmetics (SPARK MODE) ---------------------------------------
    // While the browser runs the server logic (js/server-local.js) the signed-in player has to be able to write HIS OWN wallet,
    // which also means he could give himself gems. That is harmless ONLY while real-money gem packs are switched off.
    // BEFORE you sell gems for real money: move to Blaze (Cloud Functions) and change BOTH write rules below to `allow write: if false;`.
    match /rc_wallets/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // what a player wears (public: other players see it on his profile)
    match /rc_cosmetics/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // payment log written by the payment webhook only (idempotency: one payment never credits twice)
    match /rc_payments/{id} {
      allow read, write: if false;
    }

    // General Chat: one shared doc holding a capped array of the last N messages
    // (see GENERAL_CHAT_MAX / sendGeneralChat in storage.js) — same shape as the
    // per-kingdom chat array, just server-wide and unscoped instead of per-kingdom.
    match /meta/rc_generalChat {
      allow read: if request.auth != null;

      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['messages']) &&
        request.resource.data.messages.size() <= 80;

      // Only the messages array itself can ever change — nothing else to protect
      // here since there's no ownership/seller/price logic like marketListings has.
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages']) &&
        request.resource.data.messages.size() <= 80;

      allow delete: if false;
    }
  }
}
